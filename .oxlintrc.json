{
  "plugins": ["eslint", "unicorn", "oxc", "import"],
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["ui/vendor/**"],
  "rules": {
    "no-undef": "error",
    "import/named": "error",
    "import/namespace": "error",
    "import/no-cycle": "error"
  },
  "overrides": [{ "files": ["ui/*.test.js", "tests/e2e/*.js"], "env": { "node": true } }]
}
